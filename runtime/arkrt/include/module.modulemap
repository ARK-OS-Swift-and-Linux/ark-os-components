module Musl [system] {
    header "/usr/lib/musl/include/stdio.h"
    header "/usr/lib/musl/include/unistd.h"
    header "/usr/lib/musl/include/stdlib.h"
    header "/usr/lib/musl/include/signal.h"
    header "/usr/lib/musl/include/sys/wait.h"
    header "/usr/lib/musl/include/errno.h"
    header "/usr/lib/musl/include/fcntl.h"
    export *
}
